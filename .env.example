# ===== 数据库 =====
POSTGRES_USER=aieval
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aieval

# ===== 应用 =====
# 会话 JWT 签名密钥（务必改成随机长字符串，可用 `openssl rand -hex 32` 生成）
SECRET_KEY=change_me_to_a_random_secret

# 首次部署的引导管理员（登录后请立即改密）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# 协议档 Key 加密密钥（Fernet，base64；留空则用 SECRET_KEY 派生，仅用于开发，生产必须显式配置）
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_KEY=

# 会话有效期（分钟），默认 12h
ACCESS_TOKEN_EXPIRE_MINUTES=720
# WebSocket 短票有效期（分钟）
WS_TICKET_EXPIRE_MINUTES=5

# ===== 端口 =====
WEB_PORT=80
API_PORT=8000
LIGHTRAG_PORT=9621
STRESS_PORT=19090

# ===== LightRAG（M3 真实集成时使用）=====
LIGHTRAG_LLM_API_KEY=
LIGHTRAG_LLM_BASE_URL=
LIGHTRAG_LLM_MODEL=gpt-4o-mini
LIGHTRAG_EMBEDDING_MODEL=BAAI/bge-m3
