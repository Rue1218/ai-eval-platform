# ===== 数据库 =====
POSTGRES_USER=aieval
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aieval

# ===== 应用 =====
# AgentLoop 运行参数
AGENT_LOOP_MAX_STEPS=16
AGENT_LOOP_MAX_PARALLEL_TOOL_CALLS=4
AGENT_LOOP_RECONNECT_GRACE_SECONDS=20
# API/Runner 共用的随机内部令牌；保持空值时不开放新执行接口。
RUNNER_INTERNAL_TOKEN=
# Linux 上已委派并仅挂载给 runner 的 cgroup v2 子树，不可指向整个宿主层级。
RUNNER_CGROUP_ROOT=
# 会话 JWT 签名密钥（务必改成随机长字符串，可用 `openssl rand -hex 32` 生成）
SECRET_KEY=change_me_to_a_random_secret

# 首次部署的引导管理员（登录后请立即改密）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# 协议档 Key 加密密钥（Fernet，base64；留空则用 SECRET_KEY 派生，仅用于开发，生产必须显式配置）
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_KEY=

# 协议档环境文件。生产默认挂载服务器项目根目录 .env；API 加锁刷新，Worker 只读。
PROFILE_ENV_FILE=/run/config/.env
# 页面新增的每个供应商会自动追加以下格式变量（不要手工写入真实 Key 到仓库）：
# AI_PROFILE_<PROFILE_ID_NORMALIZED>_BASE_URL=...
# AI_PROFILE_<PROFILE_ID_NORMALIZED>_MODEL=...
# AI_PROFILE_<PROFILE_ID_NORMALIZED>_API_KEY=...
# 旧单模型环境兼容别名：LLM_API_KEY / LLM_MODEL / OPENAI_BASE_URL / ANTHROPIC_BASE_URL

# 会话有效期（分钟），默认 12h
ACCESS_TOKEN_EXPIRE_MINUTES=720
# WebSocket 短票有效期（分钟）
WS_TICKET_EXPIRE_MINUTES=5

# ===== 端口 =====
WEB_PORT=80
API_PORT=8000
LIGHTRAG_PORT=9621
STRESS_PORT=19090
# Worker 访问压测引擎的内网地址（compose 默认 http://stress:19090）
STRESS_URL=http://stress:19090

# ===== LightRAG（M3 真实集成时使用）=====
LIGHTRAG_LLM_API_KEY=
LIGHTRAG_LLM_BASE_URL=
LIGHTRAG_LLM_MODEL=gpt-4o-mini
LIGHTRAG_EMBEDDING_MODEL=BAAI/bge-m3

# ===== Qwen Image 3.0 内部短工具 image.generate =====
# 只在本机/部署环境注入真实 Key，禁止提交到仓库。
QWEN_IMAGE_API_KEY=
# 也可使用 curl 示例中的 DASHSCOPE_API_KEY；QWEN_IMAGE_API_KEY 优先。
DASHSCOPE_API_KEY=
QWEN_IMAGE_API_URL=https://ws-2jjtk1qzvfbov9p0.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_IMAGE_MODEL=qwen-image-3.0
QWEN_IMAGE_TIMEOUT_SECONDS=120

# ===== 原生网络搜索与网页抓取（Firecrawl REST，不走 MCP）=====
# 仅部署环境写入真实 Key；模型、WebSocket 事件和日志均不回显。未配置时
# web_search 返回“网络搜索服务未配置”，web_fetch 仍可受 SSRF 防护地抓取文本页。
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1
FIRECRAWL_API_KEY=

# Agent 检查点：memory（默认）或 postgres。postgres 须单独评审多副本粘性路由。
AGENT_CHECKPOINTER=memory
# H5 批次 2：HITL 生产门禁。true 时混合引擎 + memory 检查点启动期 fail-fast
# （HITL resume 无法跨进程重启恢复）；生产部署设 true，单副本/测试设 false。
AGENT_HITL_STRICT_PG=false
# H5 批次 2：API 实例标识（粘性路由用）。空 = 启动期自动派生 hostname:pid；
# 多副本部署时网关按 session_id 粘性路由到同一实例（暴露于 /api/health）。
AGENT_INSTANCE_ID=
# H5 收尾演练开关（仅演练环境可临时置 true）：允许 discover 选中 worker.sandbox
# 以制造危险 bash 审批卡，验证重启恢复后必须置回 false（默认保持 fail-closed）。
AGENT_DRILL_SANDBOX_ENABLED=false
# native 首轮流式（P1）。默认开启；false 立即回退 invoke，不改历史事件。
AGENT_NATIVE_STREAM_ENABLED=true
# 逗号分隔协议档 ID；空或 * 表示全部 native。
AGENT_NATIVE_STREAM_PROFILE_IDS=
# 同轮只读工具并行（read/web_search/web_fetch）；默认关闭。
AGENT_PARALLEL_TOOL_BATCH_ENABLED=false
MAX_PARALLEL_TOOL_CALLS=3
# 并行灰度白名单：空=不开；*=全部；否则仅列出的协议档 ID。
AGENT_PARALLEL_TOOL_BATCH_PROFILE_IDS=

# ===== 混合驱动引擎（H0 基础设施；全部默认安全关闭，生产逐阶段灰度）=====
# 主开关：false 时保持骨架化纯对话（灰度回滚出口）。
HYBRID_ENGINE_ENABLED=false
# Router L1 CoT 开关：false 时纯 L0 确定性分流。
HYBRID_ROUTER_COT_ENABLED=false
# L0 置信度阈值：低于此值才触发 L1 CoT 短调用。
HYBRID_ROUTER_CONFIDENCE_THRESHOLD=0.7
# AgentDef.allowed_tools 未在 ToolRegistry 注册时启动 fail-fast。
AGENT_REGISTRY_STRICT=true
# 提示词缓存边界：false 时 assemble() 行为与骨架化版本字节级一致。
PROMPT_CACHE_ENABLED=false
# 外部 MCP fail-closed（ADR-8）：接入须先改 PRD + API.md。
EXTERNAL_MCP_ENABLED=false

# ===== 音色克隆（Agent 短工具 audio.voiceclone，OpenAI chat/completions 兼容）=====
# 不要把真实 Key 写入仓库；仅部署机 .env 注入。
MIMO_TTS_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_TTS_API_KEY=
MIMO_TTS_MODEL=mimo-v2.5-tts-voiceclone
