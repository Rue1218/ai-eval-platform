# ===== 数据库 =====
POSTGRES_USER=aieval
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aieval

# ===== 应用 =====
# 会话 JWT 签名密钥（务必改成随机长字符串，可用 `openssl rand -hex 32` 生成）
SECRET_KEY=change_me_to_a_random_secret

# 首次部署的引导管理员（登录后请立即改密）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# 协议档 Key 加密密钥（Fernet，base64；留空则用 SECRET_KEY 派生，仅用于开发，生产必须显式配置）
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_KEY=

# 协议档环境文件。生产默认挂载服务器项目根目录 .env；API 加锁刷新，Worker 只读。
PROFILE_ENV_FILE=/run/config/.env
# 页面新增的每个供应商会自动追加以下格式变量（不要手工写入真实 Key 到仓库）：
# AI_PROFILE_<PROFILE_ID_NORMALIZED>_BASE_URL=...
# AI_PROFILE_<PROFILE_ID_NORMALIZED>_MODEL=...
# AI_PROFILE_<PROFILE_ID_NORMALIZED>_API_KEY=...
# 旧单模型环境兼容别名：LLM_API_KEY / LLM_MODEL / OPENAI_BASE_URL / ANTHROPIC_BASE_URL

# 会话有效期（分钟），默认 12h
ACCESS_TOKEN_EXPIRE_MINUTES=720
# WebSocket 短票有效期（分钟）
WS_TICKET_EXPIRE_MINUTES=5

# ===== 端口 =====
WEB_PORT=80
API_PORT=8000
LIGHTRAG_PORT=9621
STRESS_PORT=19090

# ===== LightRAG（M3 真实集成时使用）=====
LIGHTRAG_LLM_API_KEY=
LIGHTRAG_LLM_BASE_URL=
LIGHTRAG_LLM_MODEL=gpt-4o-mini
LIGHTRAG_EMBEDDING_MODEL=BAAI/bge-m3

# ===== 独立 Qwen Image 3.0 MCP（可选） =====
# 只在本机/部署环境注入真实 Key，禁止提交到仓库。
QWEN_IMAGE_API_KEY=
# 也可使用 curl 示例中的 DASHSCOPE_API_KEY；QWEN_IMAGE_API_KEY 优先。
DASHSCOPE_API_KEY=
QWEN_IMAGE_API_URL=https://ws-2jjtk1qzvfbov9p0.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_IMAGE_MODEL=qwen-image-3.0
QWEN_IMAGE_TIMEOUT_SECONDS=120

# ===== 音色克隆（Agent 短工具 audio.voiceclone，OpenAI chat/completions 兼容）=====
# 不要把真实 Key 写入仓库；仅部署机 .env 注入。
MIMO_TTS_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_TTS_API_KEY=
MIMO_TTS_MODEL=mimo-v2.5-tts-voiceclone
